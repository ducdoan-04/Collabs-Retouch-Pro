{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retouch Studio Pro",
  "version": "1.0.0",
  "identifier": "com.retouchstudio.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Retouch Studio Pro — Chỉnh Sửa Chân Dung Với AI & Ảnh RAW",
        "width": 1520,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Retouch Studio",
    "copyright": "© 2026 Retouch Studio",
    "category": "Photography",
    "shortDescription": "Phần mềm chỉnh sửa chân dung Với AI & ảnh RAW chuyên nghiệp",
    "longDescription": "Retouch Studio Pro — công cụ chỉnh sửa chân dung với AI (478 điểm khuôn mặt), xử lý ảnh RAW và 148 thanh trượt màu sắc chạy offline hoàn toàn.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  }
}
